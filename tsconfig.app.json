{
  // No explicit "types" here: the workspace root has no node_modules of its
  // own, so listing e.g. "vite/client" made type-aware lint (oxlint/tsgolint)
  // fail with "Cannot find type definition file". The app's own tsconfig
  // (droid-assist/droid-assist-prototype/tsconfig.json) declares the types.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["droid-assist/**/*.ts", "droid-assist/**/*.tsx"],
  "exclude": ["droid-assist/**/*.bit-app.ts"]
}
