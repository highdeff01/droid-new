{
  // No explicit "types" here: the workspace root has no node_modules of its
  // own, so listing "node" made type-aware lint (oxlint/tsgolint) fail with
  // "Cannot find type definition file". See tsconfig.app.json.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": [
    "droid-assist/**/vite.config.js",
    "droid-assist/**/*.bit-app.ts"
  ]
}
